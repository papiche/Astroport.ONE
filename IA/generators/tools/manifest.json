          "output": {
            "type": "string",
            "minLength": 1,
            "description": "Vidéo de sortie."
          },
          "vhs": {
            "type": "boolean",
            "description": "Style lecteur VHS."
          },
          "height": {
            "type": "integer",
            "minimum": 144,
            "maximum": 2160,
            "description": "Petit côté en pixels (défaut 720). Exclusif avec size."
          },
          "size": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$",
            "description": "Taille exacte LxH, recadrage centré. Exclusif avec height."
          }
