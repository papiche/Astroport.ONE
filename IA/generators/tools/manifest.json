            "description": "Chemin du workflow ComfyUI (format API) à utiliser, ex. workflow/Text2VideoWan2.2.json."
          },
          "udrive_path": {
            "type": "string",
            "x-path": "dir",
            "description": "Dossier uDRIVE de destination (optionnel)."
          }
        },
        "required": [
          "prompt",
          "workflow_path"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_video.sh",
        "args": [
          {
            "positional": "prompt"
          },
          {
            "positional": "workflow_path"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "output": "last_line",
      "timeout_sec": 3600,
      "tags": [
        "video",
        "comfyui",
        "gpu",
        "ipfs"
      ]
    },
    {
      "name": "image_to_video",
      "description": "Anime une image (Wan 2.2 14B image→vidéo). Retourne l'URL IPFS de la vidéo. Opération lourde (GPU).",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Animation souhaitée, ex. « le personnage tourne lentement la tête »."
          },
          "image_url": {
            "type": "string",
            "minLength": 1,
            "description": "URL (IPFS, HTTP) de l'image source."
          },
          "udrive_path": {
            "type": "string",
            "x-path": "dir",
            "description": "Dossier uDRIVE de destination (optionnel)."
          }
        },
        "required": [
          "prompt",
          "image_url"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "image_to_video.sh",
        "args": [
          {
            "positional": "prompt"
          },
          {
            "positional": "image_url"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "output": "last_line",
      "timeout_sec": 3600,
      "tags": [
        "video",
        "comfyui",
        "gpu",
        "ipfs"
      ]
    },
    {
      "name": "generate_minimax",
      "description": "Génère une vidéo avec son (MiniMax H3 sur ComfyUI) : texte→vidéo, image→vidéo (first_frame) ou références visage/voix (reference_images, reference_audios). Retourne l'URL IPFS, ou le chemin du fichier si output_file est fourni. Réglage rapide : megapixels 0.4, steps 10.",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Description du plan. Avec des références, citer <Picture 1>, <Audio 1>…"
          },
          "first_frame": {
            "type": "string",
            "description": "Image de départ (image→vidéo). Incompatible avec reference_images."
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 9,
            "description": "Images de référence (visage/décor), 9 max."
          },
          "reference_audios": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "description": "Audios de référence (voix), 3 max."
          },
          "upscale": {
            "type": "number",
            "minimum": 1,
            "description": "Facteur d'upscale SeedVR2 (lent). Défaut : aucun."
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "Durée en secondes (défaut 5, entraîné ~5-15)."
          },
          "ratio": {
            "type": "string",
            "enum": [
              "1:1",
              "2:3",
              "3:2",
              "3:4",
              "4:3",
              "9:16",
              "16:9",
              "21:9"
            ],
            "description": "Ratio (défaut 16:9)."
          },
          "megapixels": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2,
            "description": "Résolution de calcul (défaut 0.4 → 864x480)."
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Nombre de steps (défaut 10)."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "Seed : mêmes paramètres + même seed = même plan."
          },
          "output_file": {
            "type": "string",
            "description": "Écrit la vidéo dans ce fichier, sans IPFS."
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 60,
            "description": "Timeout du calcul (défaut 3600)."
          },
          "udrive_path": {
            "type": "string",
            "x-path": "dir",
            "description": "Dossier uDRIVE de destination (optionnel)."
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_minimax.sh",
        "args": [
          {
            "flag": "-i",
            "param": "first_frame"
          },
          {
            "flag": "-R",
            "param": "reference_images",
            "repeat": true
          },
          {
            "flag": "-A",
            "param": "reference_audios",
            "repeat": true
          },
          {
            "flag": "-u",
            "param": "upscale"
          },
          {
            "flag": "-d",
            "param": "duration"
          },
          {
            "flag": "-r",
            "param": "ratio"
          },
          {
            "flag": "-m",
            "param": "megapixels"
          },
          {
            "flag": "-s",
            "param": "steps"
          },
          {
            "flag": "-S",
            "param": "seed"
          },
          {
            "flag": "-o",
            "param": "output_file"
          },
          {
            "flag": "-t",
            "param": "timeout_sec"
          },
          {
            "positional": "prompt"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "exit_codes": {
        "0": "ok",
        "1": "erreur",
        "3": "ComfyUI non équipé (modèles/nodes manquants)",
        "4": "timeout"
      },
      "output": "last_line",
      "timeout_sec": 18000,
      "tags": [
        "video",
        "audio",
        "minimax",
        "comfyui",
        "gpu",
        "ipfs"
      ]
    },
    {
