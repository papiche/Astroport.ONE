{
  "$comment": "Source de vérité UNIQUE des outils de IA/generators/ (Tool Calling). Lu par tool_runner.py. Chaque outil : name, description (lue par le modèle), input_schema (JSON Schema), exec (script + argv), output, timeout_sec. Voir README.tools.md. Exclus volontairement : generate_storyboard.sh (conversation interactive au terminal), image_to_3dscene.py (appelé via generate_3dscene.sh).",
  "version": 1,
  "tools": [
    {
      "name": "generate_image",
      "description": "Génère une image à partir d'un texte (ComfyUI) et la publie sur IPFS. Retourne l'URL IPFS de l'image. Durée : jusqu'à ~2 minutes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Description de l'image souhaitée (anglais conseillé)."
          },
          "udrive_path": {
            "type": "string",
            "x-path": "dir",
            "description": "Dossier uDRIVE où copier l'image (optionnel)."
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_image.sh",
        "args": [
          {
            "positional": "prompt"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "output": "last_line",
      "timeout_sec": 300,
      "tags": [
        "image",
        "comfyui",
        "gpu",
        "ipfs"
      ]
    },
    {
      "name": "generate_music",
