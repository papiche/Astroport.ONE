        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_music.sh",
        "args": [
          {
            "positional": "prompt"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "output": "last_line",
      "timeout_sec": 900,
      "tags": [
        "audio",
        "music",
        "comfyui",
        "gpu",
        "ipfs"
      ]
    },
    {
      "name": "generate_video",
      "description": "Génère une vidéo à partir d'un texte avec un workflow ComfyUI donné. Retourne l'URL IPFS de la vidéo. Opération lourde (GPU).",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Description de la vidéo."
          },
          "workflow_path": {
            "type": "string",
