          },
          "permit_description": {
            "type": "string",
            "minLength": 1,
            "description": "Description du permis."
          },
          "level": {
            "type": "string",
            "pattern": "^X[0-9]+$",
            "description": "Niveau WoTx² (X5, X10…), optionnel."
          },
          "label": {
            "type": "string",
            "description": "Libellé du niveau (Expert, Maître…), optionnel."
          }
        },
        "required": [
          "badge_id",
          "permit_name",
