    {
      "name": "generate_voice",
      "description": "Invente une voix d'après une description (Qwen3-TTS VoiceDesign) et lui fait dire une phrase. Écrit un fichier WAV (reproductible à description, texte et seed identiques) ; sert de voix de référence pour generate_minimax.",
      "input_schema": {
        "type": "object",
        "properties": {
          "voice_description": {
            "type": "string",
            "minLength": 1,
            "description": "Description du timbre, en anglais de préférence (« warm low-pitched woman, calm »)."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Phrase à prononcer."
          },
          "output_file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\.wav$",
            "description": "Chemin du fichier WAV à écrire."
          },
          "language": {
            "type": "string",
            "description": "Langue (défaut French)."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "Seed (défaut 42)."
          }
        },
        "required": [
          "voice_description",
          "text",
          "output_file"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_voice.py",
        "interpreter": "QWEN3TTS_PY",
        "args": [
          {
            "flag": "-o",
            "param": "output_file"
          },
          {
            "flag": "-l",
            "param": "language"
          },
          {
            "flag": "-S",
            "param": "seed"
          },
          {
            "positional": "voice_description"
          },
          {
            "positional": "text"
          }
        ]
      },
      "output": "last_line",
      "timeout_sec": 900,
      "tags": [
        "audio",
        "tts",
        "gpu"
      ],
      "enabled": false,
      "disabled_reason": "Intégration Qwen3-TTS en cours (doit tourner sur la station GPU) ; pas encore de garde-fou VRAM."
    },
