        "required": [
          "input",
          "output"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "video_finish.sh",
        "args": [
          {
            "flag": "-v",
            "param": "vhs",
            "boolean": true
          },
          {
            "flag": "-H",
            "param": "height"
          },
          {
            "flag": "-s",
            "param": "size"
          },
          {
            "positional": "input"
          },
          {
            "positional": "output"
          }
        ]
      },
      "output": "text",
      "timeout_sec": 1800,
      "tags": [
        "video",
        "ffmpeg"
      ]
    },
    {
      "name": "faceid",
      "description": "Détecte les visages d'une image (InsightFace via ComfyUI) et retourne un JSON {faces:[{bbox, det_score, embedding}], scene_analysis?}. scene_analysis (objet/plante/animal…) n'apparaît que si aucun visage n'est trouvé. Données biométriques : ne jamais republier les embeddings.",
      "input_schema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "Fichier local ou CID/lien IPFS."
          },
          "decryption_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "x-sensitive": true,
            "description": "Clé AES-256-GCM (64 hex) si l'image est un blob UENC du cloud chiffré."
          }
        },
        "required": [
          "image"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "faceid.sh",
        "args": [
          {
            "positional": "image"
          },
          {
            "literal": "",
            "only_if": "decryption_key_hex"
          },
          {
            "positional": "decryption_key_hex"
          }
        ]
      },
      "output": "json",
      "timeout_sec": 300,
      "tags": [
        "vision",
        "face",
        "comfyui",
        "gpu",
        "privacy"
      ]
    }
  ]
