    {
      "name": "check_storyboard",
      "description": "Valide un storyboard JSON sans rien calculer (mêmes règles que generate_scene). À appeler avant generate_scene.",
      "input_schema": {
        "type": "object",
        "properties": {
          "storyboard_path": {
            "type": "string",
            "x-path": "file",
            "description": "Chemin du storyboard .json."
          }
        },
        "required": [
          "storyboard_path"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_scene.sh",
        "args": [
          {
            "literal": "--check"
          },
          {
            "positional": "storyboard_path"
          }
        ]
      },
      "exit_codes": {
        "0": "storyboard valide",
        "2": "storyboard invalide"
      },
      "output": "text",
      "timeout_sec": 60,
      "tags": [
        "video",
        "storyboard"
      ]
    },
    {
      "name": "generate_scene",
      "description": "Rend un storyboard JSON en vidéo multi-plans (MiniMax H3) assemblée en 720p. Relancer avec le même workdir reprend la scène (plans déjà rendus conservés). Retourne l'URL IPFS de la vidéo finale. Très long : valider d'abord avec check_storyboard.",
      "input_schema": {
        "type": "object",
        "properties": {
          "storyboard_path": {
            "type": "string",
            "x-path": "file",
            "description": "Chemin du storyboard .json."
          },
          "workdir": {
            "type": "string",
            "description": "Répertoire de travail (reprise de scène)."
          },
          "cast_only": {
            "type": "boolean",
            "description": "Prépare seulement les personnages (.cast), sans rendre de plan."
          },
          "shot_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Ne (re)calcule que ce plan (0-based), sans assemblage."
          },
          "publish": {
            "type": "string",
            "enum": [
              "coop",
              "private"
            ],
            "description": "Publie dans la bibliothèque du Studio vidéo : coop (visible des Capitaines) ou private (chiffré)."
          },
          "udrive_path": {
            "type": "string",
            "x-path": "dir",
            "description": "Dossier où copier la vidéo finale."
          }
        },
        "required": [
          "storyboard_path"
        ],
        "additionalProperties": false
      },
      "exec": {
        "script": "generate_scene.sh",
        "args": [
          {
            "flag": "-w",
            "param": "workdir"
          },
          {
            "flag": "-c",
            "param": "cast_only",
            "boolean": true
          },
          {
            "flag": "-i",
            "param": "shot_index"
          },
          {
            "flag": "-p",
            "param": "publish"
          },
          {
            "positional": "storyboard_path"
          },
          {
            "positional": "udrive_path"
          }
        ]
      },
      "exit_codes": {
        "0": "ok",
        "1": "erreur",
        "2": "storyboard invalide ou usage",
        "3": "ComfyUI non équipé",
        "4": "timeout"
      },
      "output": "last_line",
      "timeout_sec": 21600,
      "tags": [
        "video",
        "scene",
        "minimax",
        "gpu",
        "ipfs"
      ]
    },
    {
      "name": "video_finish",
      "description": "Met une vidéo à l'échelle (720p par défaut, 24 i/s, AAC 48 kHz) avec style VHS optionnel. Écrit le fichier de sortie.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "x-path": "file",
            "description": "Vidéo d'entrée."
