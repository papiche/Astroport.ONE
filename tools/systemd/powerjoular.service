[Unit]
Description=PowerJoular 24/7 power consumption monitoring (RAPL)
Documentation=https://github.com/papiche/powerjoular
After=multi-user.target

[Service]
Type=simple
# PowerJoular requires root for RAPL access on Linux 5.10+
ExecStartPre=/bin/mkdir -p /var/lib/powerjoular
ExecStartPre=/bin/chown root:root /var/lib/powerjoular
# Rotation : à chaque démarrage, garder l'en-tête + les dernières 24h (86400 lignes).
# 20h12.process.sh la déclenche par « sudo systemctl restart » (seule commande sudo
# autorisée sans mot de passe) quand le CSV dépasse 48h.
ExecStartPre=/bin/sh -c 'C=/var/lib/powerjoular/power_24h.csv; if [ -f "$$C" ]; then { head -n 1 "$$C"; tail -n 86400 "$$C"; } > "$$C.tmp" && mv -f "$$C.tmp" "$$C"; fi'
ExecStart=/usr/bin/powerjoular -f /var/lib/powerjoular/power_24h.csv -t
# CSV is created with root umask (typically 644). If not readable by captain, 20h12 uses sudo to copy.
Restart=always
RestartSec=10
# stdout = 1 ligne/seconde (~86 000/jour) : c'était la 1re source du journal
# systemd, en doublon du CSV. Seules les erreurs vont au journal.
StandardOutput=null
StandardError=journal
SyslogIdentifier=powerjoular

[Install]
WantedBy=multi-user.target
